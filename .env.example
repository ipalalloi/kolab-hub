# Salin ke .env di VPS lalu isi. JANGAN commit .env dan jangan tempel nilainya di chat.
# Kunci acak: jalankan `node scripts/gen-keys.js` di VPS.

# --- Umum ---
DOMAIN=kolab.contoh.id
BASE_URL=https://kolab.contoh.id
NODE_ENV=production

# --- Basis data (dipakai docker-compose) ---
POSTGRES_PASSWORD=

# --- Kunci aplikasi (32 byte base64) ---
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
SESSION_SECRET=

# --- WhatsApp ---
# simulate = tanpa akun BSP (uji lokal); cloud = WhatsApp Cloud API resmi (langsung atau lewat BSP)
WA_MODE=simulate
# Rahasia aplikasi Meta (App Secret) untuk verifikasi X-Hub-Signature-256
WA_APP_SECRET=
# Token bebas yang juga diisi di pengaturan webhook Meta/BSP
WA_VERIFY_TOKEN=
# Base URL Cloud API. Pakai URL Graph API Meta, atau URL kompatibel Cloud API dari BSP Anda.
WA_API_BASE=https://graph.facebook.com/v21.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Nama template yang sudah disetujui Meta (bahasa: id)
WA_OTP_TEMPLATE=kolab_otp
WA_ASSIGN_TEMPLATE=kolab_tugas_baru
WA_TEMPLATE_LANG=id
WA_RATE_LIMIT_PER_MINUTE=20

# --- Web Push (Fase 2) ---
# Buat dengan `npm run gen-keys`. Kosongkan keduanya untuk mematikan push (notifikasi kembali ke WA).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kolab.contoh.id

# --- Ringkasan harian (Fase 2) ---
DIGEST_ENABLED=true
DIGEST_TIME=07:00
DIGEST_TZ=Asia/Makassar
WA_DIGEST_TEMPLATE=kolab_ringkasan_harian

# --- Operasional ---
RETENTION_DEFAULT_DAYS=90
DEFAULT_WIP_LIMIT=3
WORKER_INLINE=true
BACKUP_PASSPHRASE=
BACKUP_DIR=/var/backups/kolab
